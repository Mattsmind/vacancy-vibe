<% layout('layouts/boilerplate') %>
    <div class="py-4">
        <h1 class="display-3 fw-bold border-bottom pb-2 mb-4"> Welcome to Vacancy Vibe </h1>
        <p class="lead"> Discover unique places to stay, share your experiences, and build your next adventure. Vacancy
            Vibe is currently under active development, so expect new features and improvements as the project continues
            to grow. </p>
        <div class="alert alert-primary mt-4">
            <h4 class="alert-heading">🚧 Project Status</h4>
            <p class="mb-2"> This is an active portfolio project demonstrating modern full-stack web development using
                Node.js, Express, MongoDB, EJS, and Bootstrap.</p>

            <p class="mb-0">
                <strong>Note:</strong> All listings, reviews, and locations are generated from seeded sample data for 
                demonstration purposes. They are fictional and may not correspond to real places or businesses.</p>    
            <hr>
            <div class="row">
                <div class="col-md-6">
                    <ul class="mb-0">
                        <li>✅ User Registration</li>
                        <li>✅ Secure Authentication</li>
                        <li>✅ Authorization & Ownership</li>
                        <li>✅ Create, Edit & Delete Listings</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="mb-0">
                        <li>🚧 Cloudinary Image Uploads</li>
                        <li>🚧 Listing Galleries</li>
                        <li>🚧 Featured Vibe Photos</li>
                        <li>🚧 More Features Coming Soon</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <h3 class="card-title">Try the Demo</h3>
                <p> Don't feel like creating an account? No problem. Use one of the demo accounts below to explore
                    authenticated features. </p>
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Username</th>
                            <th>Password</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>MrDemo</td>
                            <td><code>demo@demo.net</code></td>
                            <td><code>Demo123!</code></td>
                        </tr>
                        <tr>
                            <td>Anne</td>
                            <td><code>anne@demo.net</code></td>
                            <td><code>Anne123!</code></td>
                        </tr>
                        <tr>
                            <td>Luke</td>
                            <td><code>luke@demo.net</code></td>
                            <td><code>Luke123!</code></td>
                        </tr>
                        <tr>
                            <td>Mary</td>
                            <td><code>mary@demo.net</code></td>
                            <td><code>Mary123!</code></td>
                        </tr> 
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mt-5 text-center text-muted">
            <p class="mb-0"> Thanks for checking out Vacancy Vibe! </p> <small> Built as a portfolio project and
                continuously evolving with new features. </small>
        </div>
